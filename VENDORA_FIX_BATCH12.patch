+        setError(updateError.message);
+        return;
+      }
+      setPhase('done');
+    } catch (err: unknown) {
+      setError(err instanceof Error ? err.message : 'Could not update your password');
+    } finally {
+      setIsSubmitting(false);
+    }
+  };
