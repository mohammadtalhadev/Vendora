{
  "name": "vendora",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:seed:gen": "node --experimental-strip-types scripts/generate-seed.ts",
    "db:types": "node --experimental-strip-types scripts/gen-types.ts",
    "db:types:remote": "supabase gen types typescript --linked --schema public > src/types/database.ts",
    "db:check": "node --experimental-strip-types scripts/validate-migrations.ts && node --experimental-strip-types scripts/validate-seed.ts && node --experimental-strip-types scripts/smoke-rpcs.ts",
    "db:push": "supabase db push --linked",
    "auth:verify": "node scripts/verify-auth-live.mjs",
    "db:reset": "supabase db reset --linked"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-label": "^2.1.16",
    "@radix-ui/react-select": "^2.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "msw": "^3.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^30.1.2",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
