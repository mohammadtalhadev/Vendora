# Supabase Project Configuration for Vendora
# Copy this file to .env and fill in both values from Supabase Dashboard → Settings → API.
# .env is gitignored; never commit a real key.
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-public-key>
# Optional: Sentry error monitoring. Leave unset to disable — client errors
# are always recorded in the error_logs table either way (see
# src/lib/error-reporter.ts). The DSN is a public ingest key, safe to ship
# in the browser bundle; it is NOT an auth token.
# VITE_SENTRY_DSN=https://<public-key>@<sentry-host>/<project-id>
